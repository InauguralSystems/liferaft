# Deterministic discrete-event scheduler: an array-backed binary min-heap.
#
# Every scheduled event has a key (logical_time, tiebreak, seq):
#   - logical_time: the tick at which the event is delivered.
#   - tiebreak:     orders events scheduled for the SAME time. In M1 this is 0
#                   (insertion order wins); the network adversary later sets it
#                   from the PRNG to reorder same-time deliveries reproducibly.
#   - seq:          a monotonic counter, the final tiebreak, so the order is a
#                   TOTAL order — no tie is ever resolved nondeterministically.
#
# A binary heap (not a sorted list) on purpose: the point is to put the runtime
# under irregular insert / extract-min pressure on a long-lived, churning heap.
#
# An item is {"t", "tie", "seq", "to", "ev"} — deliver event `ev` to node `to`
# at time `t`.

define sched_new as:
    return {"heap": [], "seq": 0}

define sched_empty(s) as:
    return (len of s.heap) == 0

define sched_size(s) as:
    return len of s.heap

# The minimum item without removing it, or null if empty.
define sched_peek(s) as:
    if (len of s.heap) == 0:
        return null
    return s.heap[0]

# Total order on heap items: (t, tie, seq) lexicographically.
define sched_less(a, b) as:
    if a.t != b.t:
        return a.t < b.t
    if a.tie != b.tie:
        return a.tie < b.tie
    return a.seq < b.seq

define sched_swap(h, i, j) as:
    tmp is h[i]
    h[i] is h[j]
    h[j] is tmp

# Restore the heap property at index i, treating h[0:n] as the heap.
define sched_sift_down(h, i, n) as:
    loop while 1:
        l is 2 * i + 1
        r is 2 * i + 2
        smallest is i
        if l < n and (sched_less of [h[l], h[smallest]]):
            smallest is l
        if r < n and (sched_less of [h[r], h[smallest]]):
            smallest is r
        if smallest == i:
            break
        sched_swap of [h, i, smallest]
        i is smallest

# Schedule `ev` for delivery to node `to` at time `t` with same-time order `tie`.
define sched_push(s, t, tie, to, ev) as:
    item is {"t": t, "tie": tie, "seq": s.seq, "to": to, "ev": ev}
    s.seq is s.seq + 1
    h is s.heap
    append of [h, item]
    # sift up
    i is (len of h) - 1
    loop while i > 0:
        parent is floor of ((i - 1) / 2)
        if sched_less of [h[i], h[parent]]:
            sched_swap of [h, i, parent]
            i is parent
        else:
            break

# Remove and return the minimum item, or null if empty.
define sched_pop(s) as:
    h is s.heap
    n is len of h
    if n == 0:
        return null
    top is h[0]
    last is h[n - 1]
    # drop the last slot
    s.heap is h[0 : n - 1]
    h is s.heap
    n is n - 1
    if n > 0:
        h[0] is last
        sched_sift_down of [h, 0, n]
    return top

# Drop every queued item destined for `node` (a crashed node loses whatever its
# socket had buffered). Preserves the (t, tie, seq) keys of survivors, then
# Floyd-builds the heap — so delivery order of the rest is unchanged and the run
# stays a deterministic function of the seed.
define sched_drop_to(s, node) as:
    kept is []
    for it in s.heap:
        if it.to != node:
            append of [kept, it]
    s.heap is kept
    h is s.heap
    n is len of h
    i is (floor of (n / 2)) - 1
    loop while i >= 0:
        sched_sift_down of [h, i, n]
        i is i - 1
