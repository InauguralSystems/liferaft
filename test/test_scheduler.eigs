# Min-heap scheduler self-test: extract-min must yield a total order on
# (t, tie, seq), and must drain exactly what was pushed.
load_file of "src/prng.eigs"
load_file of "src/scheduler.eigs"

s is sched_new of null
rng is prng_new of 1234

# Push 2000 events with random times and tiebreaks (churn the heap).
n is 2000
for i in range of n:
    t is prng_int of [rng, 50]
    tie is prng_int of [rng, 5]
    sched_push of [s, t, tie, "node", {"i": i}]

check_size is (sched_size of s) == n

# Drain; verify non-decreasing (t, tie, seq) and exact count.
ordered is 1
count is 0
prev_t is -1
prev_tie is -1
prev_seq is -1
loop while not (sched_empty of s):
    it is sched_pop of s
    count is count + 1
    # compare (prev_t, prev_tie, prev_seq) <= (it.t, it.tie, it.seq)
    bad is 0
    if it.t < prev_t:
        bad is 1
    elif it.t == prev_t:
        if it.tie < prev_tie:
            bad is 1
        elif it.tie == prev_tie and it.seq < prev_seq:
            bad is 1
    if bad:
        ordered is 0
    prev_t is it.t
    prev_tie is it.tie
    prev_seq is it.seq

print of f"size_ok={check_size} drained={count} total_order={ordered}"
if check_size and count == n and ordered:
    print of "scheduler: all passed"
else:
    print of "scheduler: FAILED"
